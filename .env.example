# Adres serwisu — używany w metadanych SEO, danych strukturalnych, mapie
# strony oraz jako podstawa adresu kontaktowego (kontakt@<domena>). Domyślnie
# (bez tej zmiennej) kod i tak używa maetuwe.website — ustaw ją jawnie w
# Vercel dla pewności i żeby łatwo podmienić domenę w przyszłości bez zmian w kodzie.
NEXT_PUBLIC_SITE_URL=https://maetuwe.website

# Opcjonalnie: wysyłka formularza kontaktowego przez Resend (https://resend.com).
# Bez tej wartości zgłoszenia trafiają tylko do logów serwera (widoczne w
# panelu Vercel → Logs) — formularz nadal działa, ale nie wysyła e-maili.
RESEND_API_KEY=

# Opcjonalnie: nadpisanie adresu odbiorcy i nadawcy zgłoszeń z formularza.
# Domyślnie odbiorca to kontakt@<domena z NEXT_PUBLIC_SITE_URL>.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
